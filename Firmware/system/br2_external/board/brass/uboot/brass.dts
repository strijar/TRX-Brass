/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "TRX Brass board";
	compatible = "xlnx,zynq-zed", "xlnx,zynq-7000";

	aliases {
		serial0 = &uart0;
		i2c0 = &i2c0;
		mmc0 = &sdhci0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;
	};

	chosen {
		bootargs = "";
		stdout-path = "serial0:115200n8";
	};

	usb_phy0: phy0@e0002000 {
		compatible = "ulpi-phy";
		#phy-cells = <0>;
		reg = <0xe0002000 0x1000>;
		view-port = <0x0170>;
		drv-vbus;
	};
};

&usb0 {
	status = "okay";
	usb-reset = <&gpio0 8 0>;
	dr_mode = "host";
	usb-phy = <&usb_phy0>;
};

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy>;
	enet-reset = <&gpio0 7 0>;

	ethernet_phy: ethernet-phy@0 {
		reg = <0>;
		device_type = "ethernet-phy";
	};
};

&clkc {
	ps-clk-frequency = <33333333>;
};

&sdhci0 {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&uart0 {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	/*
	 * PCF8575 has no register address: send exactly two data bytes.
	 * I2C0 is routed through PL (EMIO), so do not use early GPIO hogs.
	 * boot-env.txt resets these outputs after loading system.bit.
	 * Match the driver's software latch to that all-low state.
	 */
	rf_gpio1: gpio@20 {
		compatible = "nxp,pcf8575";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		u-boot,i2c-offset-len = <0>;
		lines-initial-states = <0xffff>;
	};

	rf_gpio2: gpio@21 {
		compatible = "nxp,pcf8575";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		u-boot,i2c-offset-len = <0>;
		lines-initial-states = <0xffff>;
	};

	rf_gpio3: gpio@22 {
		compatible = "nxp,pcf8575";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		u-boot,i2c-offset-len = <0>;
		lines-initial-states = <0xffff>;
	};

	rf_gpio4: gpio@24 {
		compatible = "nxp,pcf8575";
		reg = <0x24>;
		gpio-controller;
		#gpio-cells = <2>;
		u-boot,i2c-offset-len = <0>;
		lines-initial-states = <0xffff>;
	};
};
