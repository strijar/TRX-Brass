Subject: [PATCH] iio: adc: ti-ads1015: support multichannel scans with auxiliary raw reads

TRX Brass uses AIN2/AIN3 for forward/reflected power in a triggered
buffer, and AIN0/AIN1 for microphone keys through raw sysfs reads.

Pack all selected voltage channels in scan-index order and publish only
complete scans. Reuse the existing conversion-settling delay after every
mux/PGA/rate change. Reserve enough zeroed storage for all eight voltage
channels and the optional, dynamically positioned timestamp.

Allow raw conversions on channels outside the active scan under the ADC
mutex. Hold the IIO mode mutex across raw reads to serialize buffer
enable/disable, and balance a separate runtime-PM reference per raw read.
Keep raw reads of scanned channels and concurrent comparator events busy.
Order mode and ADC locks consistently in event configuration as well.

Conversions are sequential; trigger frequency is not the full scan rate.
Auxiliary raw reads can delay scans. No changes to the sample ABI or
userspace channel names are required. This shared driver change also
applies to ADS1115 and TLA2024.

Upstream-Status: Inappropriate [Brass-specific raw/buffer policy]

---
diff --git a/drivers/iio/adc/ti-ads1015.c b/drivers/iio/adc/ti-ads1015.c
--- a/drivers/iio/adc/ti-ads1015.c
+++ b/drivers/iio/adc/ti-ads1015.c
@@ -445,25 +445,29 @@
 	struct iio_poll_func *pf = p;
 	struct iio_dev *indio_dev = pf->indio_dev;
 	struct ads1015_data *data = iio_priv(indio_dev);
-	/* Ensure natural alignment of timestamp */
+	/*
+	 * Reserve space for all voltage channels and an aligned timestamp.
+	 * The push helper places the timestamp at the actual scan_bytes offset.
+	 */
 	struct {
-		s16 chan;
+		s16 chans[ADS1015_CHANNELS];
 		s64 timestamp __aligned(8);
 	} scan;
-	int chan, ret, res;
+	int chan, ret, res, i = 0;
 
 	memset(&scan, 0, sizeof(scan));
 
 	mutex_lock(&data->lock);
-	chan = find_first_bit(indio_dev->active_scan_mask,
-			      indio_dev->masklength);
-	ret = ads1015_get_adc_result(data, chan, &res);
-	if (ret < 0) {
-		mutex_unlock(&data->lock);
-		goto err;
-	}
-
-	scan.chan = res;
+	/* Keep raw reads from changing the mux in the middle of a scan. */
+	for_each_set_bit(chan, indio_dev->active_scan_mask, ADS1015_CHANNELS) {
+		ret = ads1015_get_adc_result(data, chan, &res);
+		if (ret < 0) {
+			mutex_unlock(&data->lock);
+			goto err;
+		}
+
+		scan.chans[i++] = res;
+	}
 	mutex_unlock(&data->lock);
 
 	iio_push_to_buffers_with_timestamp(indio_dev, &scan,
@@ -540,27 +544,34 @@
 	int ret, idx;
 	struct ads1015_data *data = iio_priv(indio_dev);
 
+	/*
+	 * Serialize with buffer enable/disable before taking the ADC lock.
+	 * Raw reads of channels outside the scan may share the powered ADC.
+	 */
+	mutex_lock(&indio_dev->mlock);
 	mutex_lock(&data->lock);
 	switch (mask) {
 	case IIO_CHAN_INFO_RAW:
-		ret = iio_device_claim_direct_mode(indio_dev);
-		if (ret)
+		if (iio_buffer_enabled(indio_dev) &&
+		    test_bit(chan->scan_index, indio_dev->active_scan_mask)) {
+			ret = -EBUSY;
 			break;
+		}
 
 		if (ads1015_event_channel_enabled(data) &&
 				data->event_channel != chan->address) {
 			ret = -EBUSY;
-			goto release_direct;
+			break;
 		}
 
 		ret = ads1015_set_power_state(data, true);
 		if (ret < 0)
-			goto release_direct;
+			break;
 
 		ret = ads1015_get_adc_result(data, chan->address, val);
 		if (ret < 0) {
 			ads1015_set_power_state(data, false);
-			goto release_direct;
+			break;
 		}
 
 		*val = sign_extend32(*val >> chan->scan_type.shift,
@@ -568,11 +579,9 @@
 
 		ret = ads1015_set_power_state(data, false);
 		if (ret < 0)
-			goto release_direct;
+			break;
 
 		ret = IIO_VAL_INT;
-release_direct:
-		iio_device_release_direct_mode(indio_dev);
 		break;
 	case IIO_CHAN_INFO_SCALE:
 		idx = data->channel_data[chan->address].pga;
@@ -590,6 +599,7 @@
 		break;
 	}
 	mutex_unlock(&data->lock);
+	mutex_unlock(&indio_dev->mlock);
 
 	return ret;
 }
@@ -813,22 +823,20 @@
 	int comp_mode = (dir == IIO_EV_DIR_EITHER) ?
 		ADS1015_CFG_COMP_MODE_WINDOW : ADS1015_CFG_COMP_MODE_TRAD;
 
+	/* Take mlock before data->lock, as in ads1015_read_raw(). */
+	ret = iio_device_claim_direct_mode(indio_dev);
+	if (ret)
+		return ret;
+
 	mutex_lock(&data->lock);
-
-	/* Prevent from enabling both buffer and event at a time */
-	ret = iio_device_claim_direct_mode(indio_dev);
-	if (ret) {
-		mutex_unlock(&data->lock);
-		return ret;
-	}
 
 	if (state)
 		ret = ads1015_enable_event_config(data, chan, comp_mode);
 	else
 		ret = ads1015_disable_event_config(data, chan, comp_mode);
 
+	mutex_unlock(&data->lock);
 	iio_device_release_direct_mode(indio_dev);
-	mutex_unlock(&data->lock);
 
 	return ret;
 }
@@ -878,7 +886,6 @@
 static const struct iio_buffer_setup_ops ads1015_buffer_setup_ops = {
 	.preenable	= ads1015_buffer_preenable,
 	.postdisable	= ads1015_buffer_postdisable,
-	.validate_scan_mask = &iio_validate_scan_mask_onehot,
 };
 
 static const struct iio_info ads1015_info = {
